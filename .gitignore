# Ignore env file
env/

# Ignore python cache
*.pyc
__pycache__/
*.joblib

# Ignore pkl files
*.pkl

# Ignore bench results
bench/results/

# Ignore scratch simulation output. The committed example runs under
# outputs/example_*.csv stay tracked; everything else in outputs/ is
# per-run scratch. ASTRA-Sim regenerates its inputs on every run, and
# --no-cleanup-inputs can leave gigabytes of them behind.
outputs/*
!outputs/example_*.csv
astra-sim/inputs/runs/

# AI agent cache files
.claude/
.codex/
.cursor/
.copilot/
.aider*
.continue/

# NB: no blanket ``outputs/`` rule here — it would override the
# ``!outputs/example_*.csv`` negation above and untrack the committed
# example runs. The local fork had one; upstream's ``outputs/*`` covers
# the same scratch output without the contradiction.

# Local vLLM source checkouts (runner.py is written against them).
# Version-agnostic so a 0.28.0 checkout is ignored too.
vllm-*/

# Logs
*.log
tools/mem_bench/logs/

# OS / editor junk
.DS_Store
*.swp
*.swo

